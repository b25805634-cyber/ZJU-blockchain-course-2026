# 可选。作业默认用本地 Hardhat，这两项留空也能跑 npm test 和 npm run deploy。
# 要上 Sepolia 再填。复制成 contracts/.env，不要提交 .env。

# Sepolia 的 HTTPS RPC。Alchemy、Infura 或你自己的节点都行。带 API key 的地址不要写进仓库。
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/你的key

# 部署账户私钥，0x 开头。这个账户付 gas，并拿出一点 ETH 放进池子。
# 用测试账户，不要填主网有钱的钥匙。
DEPLOYER_PRIVATE_KEY=0x
